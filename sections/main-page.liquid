{% if page.handle == 'personalisieren' %}
  {{ 'cw-personalize-page.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'cw-personalize-page.js' | asset_url }}" defer></script>
  {% render 'cw-personalize-studio', section: section %}
{% else %}
{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div class="section page-width-content{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}">
  <div
    class="
      spacing-style
      layout-panel-flex
      layout-panel-flex--column
      section-content-wrapper
      mobile-column
    "
    style="
      {% render 'layout-panel-style', settings: section.settings %}
      {% render 'spacing-style', settings: section.settings %}
    "
  >
    {% content_for 'blocks' %}
  </div>
</div>
{% endif %}

{% schema %}
{
  "name": "t:names.page",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Couple Wear · Personalisierungsseite"
    },
    {
      "type": "paragraph",
      "content": "Diese Einstellungen werden nur verwendet, wenn die Seite den URL-Handle „personalisieren“ besitzt."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Studio-Überschrift",
      "default": "Macht es zu eurem."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Studio-Beschreibung",
      "default": "Personalisiert euren Pullover mit den Namen und dem Datum, das euch verbindet. Eure Vorschau verändert sich sofort."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Printful-Pullover",
      "info": "Wähle das Produkt, das über die Printful-App mit Shopify synchronisiert wurde."
    },
    {
      "type": "image_picker",
      "id": "artwork",
      "label": "Linienkunst-Motiv (optional)"
    },
    {
      "type": "text",
      "id": "example_names",
      "label": "Beispiel-Namen",
      "default": "David & Lena"
    },
    {
      "type": "text",
      "id": "example_date",
      "label": "Beispiel-Datum",
      "default": "05.08.2022"
    },
    {
      "type": "range",
      "id": "preview_x",
      "label": "Vorschau horizontal",
      "min": 15,
      "max": 85,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "preview_y",
      "label": "Vorschau vertikal",
      "min": 15,
      "max": 85,
      "step": 1,
      "unit": "%",
      "default": 57
    },
    {
      "type": "range",
      "id": "preview_width",
      "label": "Vorschau-Größe",
      "min": 18,
      "max": 75,
      "step": 1,
      "unit": "%",
      "default": 43
    },
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        }
      ],
      "default": "column",
      "visible_if": "{{ section.settings.gap < 0 }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
