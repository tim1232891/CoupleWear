{{ 'cw-personalize-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cw-personalize-page.js' | asset_url }}" defer></script>

{% render 'cw-personalize-studio', section: section %}

{% schema %}
{
  "name": "Couple Wear · Studio",
  "settings": [
    {"type":"text","id":"title","label":"Überschrift","default":"Eure Geschichte. Als Design."},
    {"type":"textarea","id":"description","label":"Beschreibung","default":"Ladet euer Lieblingsfoto hoch, wählt einen Stil und gestaltet ein persönliches Kleidungsstück. Namen und Datum werden exakt gesetzt – Buchstabe für Buchstabe."},
    {"type":"header","content":"Produkte"},
    {"type":"product","id":"product_hoodie","label":"Printful-Hoodie","info":"Wähle ein veröffentlichtes, mit Printful synchronisiertes Hoodie-Produkt."},
    {"type":"product","id":"product_shirt","label":"Printful-T-Shirt","info":"Wähle ein veröffentlichtes, mit Printful synchronisiertes T-Shirt-Produkt."},
    {"type":"product","id":"product","label":"Fallback-Produkt","info":"Wird verwendet, solange Hoodie oder T-Shirt noch nicht gewählt wurden."},
    {"type":"header","content":"Sichere Design-API"},
    {"type":"url","id":"api_endpoint","label":"Öffentliche Backend-URL","info":"Nur die URL des Couple-Wear-Backends, niemals einen API-Schlüssel eintragen. Leer lassen für Demo-Modus."},
    {"type":"image_picker","id":"artwork","label":"Linienkunst-Motiv (optional)"},
    {"type":"text","id":"example_names","label":"Beispiel-Namen","default":"Lena & David"},
    {"type":"text","id":"example_date","label":"Beispiel-Datum","default":"05.08.2022"},
    {"type":"range","id":"preview_x","label":"Vorschau horizontal","min":15,"max":85,"step":1,"unit":"%","default":50},
    {"type":"range","id":"preview_y","label":"Vorschau vertikal","min":15,"max":85,"step":1,"unit":"%","default":57},
    {"type":"range","id":"preview_width","label":"Vorschau-Größe","min":18,"max":75,"step":1,"unit":"%","default":43}
  ],
  "presets": [{"name":"Couple Wear · Personalisierungsstudio"}]
}
{% endschema %}
