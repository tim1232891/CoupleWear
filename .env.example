# Copy this file to .env and fill in the values locally.
# Never commit the real token.
PRINTFUL_API_TOKEN=
PRINTFUL_STORE_ID=
PRINTFUL_API_ENABLED=false
PRINTFUL_API_BASE_URL=https://api.printful.com

# Server-side OpenAI image editing. Never expose this value in Shopify Liquid.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_API_BASE_URL=https://api.openai.com

# Couple Wear Studio backend.
PORT=9292
PUBLIC_BASE_URL=http://localhost:9292
ALLOWED_ORIGINS=http://localhost:9292,https://xhd08b-h3.myshopify.com
SIGNING_SECRET=
DESIGN_RETENTION_HOURS=24

# Shopify webhooks. Obtain these from a custom Shopify app, not the theme.
SHOPIFY_API_SECRET=

# Safety gate: manual is the default. api-draft creates unconfirmed drafts only.
PRINTFUL_ORDER_MODE=manual
PRINTFUL_VARIANT_MAP_JSON={}
