{% comment %}
  Simple text personalization for a Printful-synced product.
  This snippet is rendered inside Horizon's native product form, therefore the
  visible line-item properties travel with the Shopify order.
{% endcomment %}
{%- liquid
  assign cw_mockup_image = block_settings.cw_mockup_image
  assign cw_artwork_image = block_settings.cw_artwork_image
  assign cw_detected_hoodie = false
  assign cw_product_words = product.title | append: ' ' | append: product.type | downcase
  if cw_product_words contains 'hoodie' or cw_product_words contains 'kapuzen'
    assign cw_detected_hoodie = true
  endif
  if cw_artwork_image != blank
    assign cw_artwork_url = cw_artwork_image | image_url: width: 1000
  else
    assign cw_artwork_url = 'cw-hands-heart.svg' | asset_url
  endif
-%}
{{ 'cw-customizer.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cw-customizer.js' | asset_url }}" defer></script>

<section
  class="cw-personalizer"
  data-cw-personalizer
  data-cw-initial-names="{{ block_settings.cw_example_names | default: 'David & Lena' | escape }}"
  data-cw-initial-date="{{ block_settings.cw_example_date | default: '05.08.2022' | escape }}"
  style="--cw-pos-x:{{ block_settings.cw_position_x | default: 50 }}%;--cw-pos-y:{{ block_settings.cw_position_y | default: 49 }}%;--cw-print-width:{{ block_settings.cw_print_width | default: 48 }}%;"
  aria-labelledby="cw-personalizer-title-{{ section.id }}"
>
  <header class="cw-personalizer__intro">
    <p class="cw-personalizer__eyebrow"><span aria-hidden="true">✦</span> EURE GESCHICHTE. EUER LOOK.</p>
    <h2 class="cw-personalizer__title" id="cw-personalizer-title-{{ section.id }}">{{ block_settings.cw_title | default: 'Macht es zu eurem.' | escape }}</h2>
    <p class="cw-personalizer__subtitle">{{ block_settings.cw_description | default: 'Tragt eure Namen und euer besonderes Datum ein.' | escape }}</p>
  </header>

  <div class="cw-personalizer__layout">
    <div class="cw-personalizer__preview-card">
      <div class="cw-personalizer__preview-top">
        <span class="cw-personalizer__live"><span class="cw-personalizer__live-dot" aria-hidden="true"></span> LIVE-VORSCHAU</span>
        <span class="cw-personalizer__edition">{% if cw_detected_hoodie %}HOODIE{% else %}T-SHIRT{% endif %} / PERSONAL EDITION</span>
      </div>
      <div class="cw-personalizer__stage" role="img" aria-label="Vorschau des Kleidungsstücks mit Namen und Datum">
        {%- if cw_mockup_image != blank -%}
          {{ cw_mockup_image | image_url: width: 1100 | image_tag: class: 'cw-personalizer__mockup', widths: '400, 700, 900, 1100', loading: 'lazy', alt: 'Blanko-Produkt für die personalisierte Vorschau' }}
        {%- else -%}
          <svg class="cw-personalizer__garment" viewBox="0 0 600 650" role="img" aria-label="Illustration des Kleidungsstücks" xmlns="http://www.w3.org/2000/svg">
            <defs><linearGradient id="cw-fabric-{{ section.id }}" x1="0" x2="1" y1="0" y2="1"><stop stop-color="#fafbf9"/><stop offset=".58" stop-color="#e9ece9"/><stop offset="1" stop-color="#dce3e1"/></linearGradient></defs>
            {% if cw_detected_hoodie %}
              <path d="M193 135 Q206 79 300 60 Q395 77 408 135 Q414 172 389 204 L211 204 Q187 169 193 135Z" fill="#edf0ee" stroke="#c7cecb" stroke-width="5"/>
              <path d="M200 149 L129 179 L56 383 Q54 399 70 410 L120 427 Q139 431 147 410 L180 322 L182 564 Q183 580 199 580 L402 580 Q419 580 420 564 L421 322 L453 411 Q463 431 479 427 L530 409 Q546 398 541 382 L470 178 L407 149 Q387 198 301 199 Q218 197 200 149Z" fill="url(#cw-fabric-{{ section.id }})" stroke="#c7cecb" stroke-width="4"/>
            {% else %}
              <path d="M203 108 Q243 119 301 119 Q358 119 399 108 L503 158 L555 282 L469 322 L424 240 L424 561 Q301 577 177 561 L177 240 L131 322 L45 282 L97 158Z" fill="url(#cw-fabric-{{ section.id }})" stroke="#c7cecb" stroke-width="4"/>
              <path d="M240 115 Q300 191 360 115" fill="#e2e8e5" stroke="#c7cecb" stroke-width="4"/>
            {% endif %}
          </svg>
        {%- endif -%}
        <div class="cw-personalizer__print" aria-hidden="true">
          <img class="cw-personalizer__artwork" src="{{ cw_artwork_url }}" width="700" height="390" alt="" loading="lazy">
          <span class="cw-personalizer__live-text" data-cw-names-preview>{{ block_settings.cw_example_names | default: 'David & Lena' | escape }}</span>
          <span class="cw-personalizer__live-date" data-cw-date-preview>{{ block_settings.cw_example_date | default: '05.08.2022' | escape }}</span>
        </div>
      </div>
      <div class="cw-personalizer__preview-bottom"><span>PERSÖNLICH FÜR EUCH.</span><span aria-hidden="true">♡</span></div>
    </div>

    <div class="cw-personalizer__controls">
      <div class="cw-personalizer__step-label"><span>01</span> PERSÖNLICHE ANGABEN</div>
      <div class="cw-personalizer__field-group">
        <label class="cw-personalizer__field-label" for="cw-names-{{ section.id }}">Eure Namen <span aria-hidden="true">*</span></label>
        <input class="cw-personalizer__input" type="text" id="cw-names-{{ section.id }}" name="properties[Namen]" placeholder="z. B. David & Lena" maxlength="38" autocomplete="off" required data-cw-names-input aria-describedby="cw-names-help-{{ section.id }}">
        <span class="cw-personalizer__help"><span id="cw-names-help-{{ section.id }}">Bitte Schreibweise prüfen</span><span data-cw-counter>0 / 38</span></span>
      </div>
      <div class="cw-personalizer__field-group">
        <label class="cw-personalizer__field-label" for="cw-date-{{ section.id }}">Euer Datum <span class="cw-personalizer__optional">(optional)</span></label>
        <input class="cw-personalizer__input" type="text" id="cw-date-{{ section.id }}" name="properties[Datum]" placeholder="z. B. 05.08.2022" maxlength="20" autocomplete="off" data-cw-date-input>
      </div>
      <input type="hidden" name="properties[Personalisierung]" value="" data-cw-summary-input>
      <input type="hidden" name="properties[_CW Produktionsstatus]" value="Printful-Personalisierung erforderlich">

      <aside class="cw-personalizer__note">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M12 21s-8-4.5-8-11a4.5 4.5 0 0 1 8-2.5A4.5 4.5 0 0 1 20 10c0 6.5-8 11-8 11Z"/></svg>
        <p>Diese Angaben werden mit der Shopify-Bestellung an den personalisierten Printful-Auftrag übergeben. Vor dem Druck wird der Entwurf geprüft.</p>
      </aside>
      <p class="cw-personalizer__disclaimer">Die Vorschau dient zur Orientierung. Druckgröße und Position können leicht abweichen.</p>
    </div>
  </div>
  <p class="cw-personalizer__form-status visually-hidden" aria-live="polite" data-cw-status></p>
</section>
