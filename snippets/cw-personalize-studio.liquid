{%- liquid
  assign cw_hoodie = section.settings.product_hoodie
  assign cw_shirt = section.settings.product_shirt
  assign cw_product = cw_hoodie | default: cw_shirt | default: section.settings.product
  if cw_product == blank
    assign cw_product = collections.all.products.first
  endif

  assign cw_variant = cw_product.selected_or_first_available_variant
  assign cw_product_image = cw_variant.featured_image | default: cw_product.featured_image
  assign cw_form_id = 'CW-AI-Studio-' | append: section.id

  if section.settings.artwork != blank
    assign cw_artwork_url = section.settings.artwork | image_url: width: 1200
  else
    assign cw_artwork_url = 'cw-style-minimal.svg' | asset_url
  endif
-%}

<section
  class="cw-studio"
  data-cw-studio
  data-api-endpoint="{{ section.settings.api_endpoint | escape }}"
  data-demo-mode="{% if section.settings.api_endpoint == blank %}true{% else %}false{% endif %}"
  data-example-names="{{ section.settings.example_names | escape }}"
  data-example-date="{{ section.settings.example_date | escape }}"
  style="--cw-preview-x:{{ section.settings.preview_x }}%;--cw-preview-y:{{ section.settings.preview_y }}%;--cw-preview-width:{{ section.settings.preview_width }}%;"
  aria-labelledby="cw-studio-title-{{ section.id }}"
>
  <div class="cw-studio__topbar">
    <a class="cw-studio__back" href="{{ routes.root_url }}"><span aria-hidden="true">←</span> Zurück zum Shop</a>
    <span class="cw-studio__top-note"><i aria-hidden="true"></i> Privat & sicher verarbeitet</span>
  </div>

  <div class="cw-studio__intro">
    <p class="cw-studio__eyebrow"><span aria-hidden="true">✦</span> COUPLE WEAR AI STUDIO</p>
    <h1 id="cw-studio-title-{{ section.id }}">{{ section.settings.title | escape }}</h1>
    <p>{{ section.settings.description | escape }}</p>
    <ol class="cw-studio__progress" aria-label="Ablauf">
      <li class="is-active" data-cw-progress="1"><span>1</span> Foto</li>
      <li data-cw-progress="2"><span>2</span> Stil</li>
      <li data-cw-progress="3"><span>3</span> Design</li>
      <li data-cw-progress="4"><span>4</span> Text</li>
      <li data-cw-progress="5"><span>5</span> Produkt</li>
    </ol>
  </div>

  <div class="cw-studio__shell">
    <div class="cw-studio__visual" aria-label="Live-Vorschau des personalisierten Kleidungsstücks">
      <div class="cw-studio__visual-heading">
        <span><i aria-hidden="true"></i> LIVE-VORSCHAU</span>
        <span data-cw-preview-badge>{% if section.settings.api_endpoint == blank %}DEMO{% else %}AI DESIGN{% endif %}</span>
      </div>
      <div class="cw-studio__mockup">
        {%- if cw_product_image != blank -%}
          <img class="cw-studio__product-image" src="{{ cw_product_image | image_url: width: 1400 }}" width="{{ cw_product_image.width }}" height="{{ cw_product_image.height }}" alt="{{ cw_product.title | escape }}" loading="eager" fetchpriority="high" data-cw-product-image>
        {%- else -%}
          <img class="cw-studio__product-image" src="{{ 'cw-hoodie-mockup.svg' | asset_url }}" width="1000" height="1200" alt="Personalisierbarer Hoodie" data-cw-product-image>
        {%- endif -%}
        <div class="cw-studio__print" data-cw-print aria-hidden="true">
          <img src="{{ cw_artwork_url }}" width="900" height="900" alt="" data-cw-design-image>
          <strong data-cw-names-preview data-font="signature">{{ section.settings.example_names | escape }}</strong>
          <span data-cw-date-preview>{{ section.settings.example_date | escape }}</span>
          <small data-cw-extra-preview></small>
        </div>
        <span class="cw-studio__zoom-note"><span aria-hidden="true">✦</span> Text aktualisiert sich sofort</span>
      </div>
      <div class="cw-studio__visual-footer"><span>EURE GESCHICHTE. EUER DESIGN.</span><span aria-hidden="true">♡</span></div>
    </div>

    <div class="cw-studio__content">
      {%- if cw_product != blank and cw_variant != blank -%}
        {%- form 'product', cw_product, id: cw_form_id, class: 'cw-studio__form' -%}
          <section class="cw-studio__step" aria-labelledby="cw-upload-title-{{ section.id }}">
            <div class="cw-studio__step-heading"><span>01</span><div><h2 id="cw-upload-title-{{ section.id }}">Euer Foto</h2><p>Für echte Wiedererkennbarkeit brauchen wir ein scharfes Foto, auf dem beide Gesichter deutlich zu sehen sind.</p></div></div>
            <label class="cw-studio__dropzone" data-cw-dropzone>
              <input type="file" accept="image/jpeg,image/png,image/webp" data-cw-file-input>
              <span class="cw-studio__upload-icon" aria-hidden="true">↥</span>
              <strong>Foto hierher ziehen</strong>
              <span>oder vom Gerät auswählen · JPG, PNG, WebP · max. 10 MB</span>
              <img alt="Vorschau des ausgewählten Fotos" data-cw-original-preview hidden>
            </label>
            <ul class="cw-studio__photo-tips" aria-label="Tipps für ein gutes Ergebnis">
              <li><span aria-hidden="true">✓</span> Beide Gesichter groß, scharf und gut beleuchtet</li>
              <li><span aria-hidden="true">✓</span> Möglichst keine Sonnenbrille, Filter oder verdeckten Gesichtsteile</li>
              <li><span aria-hidden="true">✓</span> Nahaufnahme ist besser als ein weit entferntes Ganzkörperfoto</li>
            </ul>
            <label class="cw-studio__consent"><input type="checkbox" data-cw-consent><span>Ich bin berechtigt, dieses Foto zu verwenden, und stimme der Verarbeitung durch den beschriebenen KI-Dienst zur Design-Erstellung zu. Das Original wird nach der Verarbeitung gelöscht.</span></label>
            <p class="cw-studio__privacy-note">Keine Nutzung für Werbung oder Training durch Couple Wear. Nicht bestellte Entwürfe werden automatisch gelöscht. <a href="{{ routes.root_url }}pages/datenschutz">Mehr zum Datenschutz</a></p>
          </section>

          <section class="cw-studio__step" aria-labelledby="cw-style-title-{{ section.id }}">
            <div class="cw-studio__step-heading"><span>02</span><div><h2 id="cw-style-title-{{ section.id }}">Euren Stil wählen</h2><p>Gesichtsform, Frisur, Proportionen und markante Merkmale bleiben die wichtigste Referenz.</p></div></div>
            <div class="cw-studio__styles" role="radiogroup" aria-labelledby="cw-style-title-{{ section.id }}">
              <label class="cw-studio__style is-selected"><input type="radio" name="cw-style-{{ section.id }}" value="minimal" data-cw-style data-preview-url="{{ 'cw-style-minimal.svg' | asset_url }}" checked><img src="{{ 'cw-style-minimal.svg' | asset_url }}" alt="Beispiel für Minimal Line Art" width="360" height="360" loading="lazy"><strong>Minimal Line Art</strong><span>Fein & reduziert</span></label>
              <label class="cw-studio__style"><input type="radio" name="cw-style-{{ section.id }}" value="heart" data-cw-style data-preview-url="{{ 'cw-style-heart.svg' | asset_url }}"><img src="{{ 'cw-style-heart.svg' | asset_url }}" alt="Beispiel für Romantic Heart" width="360" height="360" loading="lazy"><strong>Romantic Heart</strong><span>Sanft umrahmt</span></label>
              <label class="cw-studio__style"><input type="radio" name="cw-style-{{ section.id }}" value="embrace" data-cw-style data-preview-url="{{ 'cw-style-embrace.svg' | asset_url }}"><img src="{{ 'cw-style-embrace.svg' | asset_url }}" alt="Beispiel für Loving Embrace" width="360" height="360" loading="lazy"><strong>Loving Embrace</strong><span>Fließend & nah</span></label>
              <label class="cw-studio__style"><input type="radio" name="cw-style-{{ section.id }}" value="hands" data-cw-style data-preview-url="{{ 'cw-style-hands.svg' | asset_url }}"><img src="{{ 'cw-style-hands.svg' | asset_url }}" alt="Beispiel für Hands of Love" width="360" height="360" loading="lazy"><strong>Hands of Love</strong><span>Symbolisch & elegant</span></label>
            </div>
          </section>

          <section class="cw-studio__step" aria-labelledby="cw-generate-title-{{ section.id }}">
            <div class="cw-studio__step-heading"><span>03</span><div><h2 id="cw-generate-title-{{ section.id }}">Identitätstreues KI-Design</h2><p>Die hochauflösende Verarbeitung kann mehrere Minuten dauern. Prüft beide Gesichter vor dem Kauf; bei Bedarf könnt ihr kostenlos neu generieren.</p></div></div>
            <button class="cw-studio__generate" type="button" data-cw-generate><span data-cw-generate-label>Mein Design erstellen</span><span aria-hidden="true">✦</span></button>
            <div class="cw-studio__generation-progress" data-cw-generation-progress hidden><span><i data-cw-progress-bar></i></span><p data-cw-generation-message>Foto wird sicher in hoher Auflösung vorbereitet …</p></div>
            <div class="cw-studio__result" data-cw-result hidden><div><span>Original</span><img alt="Originalfoto" data-cw-result-before></div><div><span>Linienkunst</span><img alt="Erzeugte Linienkunst" data-cw-result-after></div><button type="button" data-cw-regenerate>↻ Neu generieren</button></div>
            <p class="cw-studio__demo-note" data-cw-demo-note {% unless section.settings.api_endpoint == blank %}hidden{% endunless %}><strong>Demo-Modus:</strong> Das gezeigte Motiv ist nur ein Muster und wird noch nicht aus eurem Foto erzeugt. Für die echte Foto-Kontur wird die geschützte Backend-URL benötigt; ein serverseitiger KI-Schlüssel aktiviert zusätzlich die Premium-Qualität.</p>
          </section>

          <section class="cw-studio__step" aria-labelledby="cw-personal-title-{{ section.id }}">
            <div class="cw-studio__step-heading"><span>04</span><div><h2 id="cw-personal-title-{{ section.id }}">Exakt personalisieren</h2><p>Diese Texte werden programmatisch gesetzt, nicht von der KI.</p></div></div>
            <div class="cw-studio__field-grid">
              <div class="cw-studio__field"><label for="cw-name-one-{{ section.id }}">Name 1 <em>*</em></label><input id="cw-name-one-{{ section.id }}" name="properties[Name 1]" type="text" maxlength="18" placeholder="Lena" autocomplete="off" required data-cw-name-one></div>
              <div class="cw-studio__field"><label for="cw-name-two-{{ section.id }}">Name 2 <em>*</em></label><input id="cw-name-two-{{ section.id }}" name="properties[Name 2]" type="text" maxlength="18" placeholder="David" autocomplete="off" required data-cw-name-two></div>
            </div>
            <div class="cw-studio__field-grid">
              <div class="cw-studio__field"><label for="cw-date-{{ section.id }}">Jahr oder Datum</label><input id="cw-date-{{ section.id }}" name="properties[Datum]" type="text" maxlength="20" placeholder="05.08.2022" autocomplete="off" data-cw-date></div>
              <div class="cw-studio__field"><label for="cw-font-{{ section.id }}">Schriftart</label><div class="cw-studio__select-wrap"><select id="cw-font-{{ section.id }}" name="properties[Schriftart]" data-cw-font><option value="signature">Signature</option><option value="editorial">Editorial Serif</option><option value="modern">Modern Sans</option></select><span aria-hidden="true">⌄</span></div></div>
            </div>
            <div class="cw-studio__field"><label for="cw-extra-{{ section.id }}">Kurzer Zusatz <small>(optional)</small></label><input id="cw-extra-{{ section.id }}" name="properties[Zusatztext]" type="text" maxlength="28" placeholder="z. B. für immer wir" autocomplete="off" data-cw-extra><div class="cw-studio__help"><span>Änderungen erscheinen sofort</span><span data-cw-counter>0 / 64</span></div></div>
          </section>

          <section class="cw-studio__step" aria-labelledby="cw-product-title-{{ section.id }}">
            <div class="cw-studio__step-heading"><span>05</span><div><h2 id="cw-product-title-{{ section.id }}">Produkt auswählen</h2><p>Nur tatsächlich in Shopify verfügbare Printful-Varianten werden angezeigt.</p></div></div>
            <div class="cw-studio__product-types" data-cw-product-types>
              {%- if cw_hoodie != blank -%}{%- assign hoodie_image = cw_hoodie.featured_image -%}<button type="button" class="is-selected" data-cw-product-choice="hoodie" data-product-title="{{ cw_hoodie.title | escape }}" {% if hoodie_image != blank %}data-product-image="{{ hoodie_image | image_url: width: 1400 }}"{% endif %}><span>Hoodie</span><small>{{ cw_hoodie.price | money }}</small></button>{%- endif -%}
              {%- if cw_shirt != blank -%}{%- assign shirt_image = cw_shirt.featured_image -%}<button type="button" data-cw-product-choice="shirt" data-product-title="{{ cw_shirt.title | escape }}" {% if shirt_image != blank %}data-product-image="{{ shirt_image | image_url: width: 1400 }}"{% endif %}><span>T-Shirt</span><small>{{ cw_shirt.price | money }}</small></button>{%- endif -%}
              {%- if cw_hoodie == blank and cw_shirt == blank -%}<button type="button" class="is-selected" data-cw-product-choice="fallback" data-product-title="{{ cw_product.title | escape }}" {% if cw_product_image != blank %}data-product-image="{{ cw_product_image | image_url: width: 1400 }}"{% endif %}><span>{{ cw_product.type | default: 'Produkt' | escape }}</span><small>{{ cw_product.price | money }}</small></button>{%- endif -%}
            </div>
            <div class="cw-studio__field-grid">
              <div class="cw-studio__field"><label for="cw-variant-{{ section.id }}">Farbe & Größe</label><div class="cw-studio__select-wrap"><select id="cw-variant-{{ section.id }}" name="id" data-cw-variant-select>
                {%- if cw_hoodie != blank -%}{%- for variant in cw_hoodie.variants -%}{%- assign image = variant.featured_image | default: cw_hoodie.featured_image -%}<option value="{{ variant.id }}" data-product-type="hoodie" data-price="{{ variant.price | money | escape }}" data-available="{{ variant.available }}" {% if image != blank %}data-image="{{ image | image_url: width: 1400 }}"{% endif %}>{{ variant.title | escape }}{% unless variant.available %} – Ausverkauft{% endunless %}</option>{%- endfor -%}{%- endif -%}
                {%- if cw_shirt != blank -%}{%- for variant in cw_shirt.variants -%}{%- assign image = variant.featured_image | default: cw_shirt.featured_image -%}<option value="{{ variant.id }}" data-product-type="shirt" data-price="{{ variant.price | money | escape }}" data-available="{{ variant.available }}" {% if image != blank %}data-image="{{ image | image_url: width: 1400 }}"{% endif %}>{{ variant.title | escape }}{% unless variant.available %} – Ausverkauft{% endunless %}</option>{%- endfor -%}{%- endif -%}
                {%- if cw_hoodie == blank and cw_shirt == blank -%}{%- for variant in cw_product.variants -%}{%- assign image = variant.featured_image | default: cw_product.featured_image -%}<option value="{{ variant.id }}" data-product-type="fallback" data-price="{{ variant.price | money | escape }}" data-available="{{ variant.available }}" {% if image != blank %}data-image="{{ image | image_url: width: 1400 }}"{% endif %}>{{ variant.title | escape }}{% unless variant.available %} – Ausverkauft{% endunless %}</option>{%- endfor -%}{%- endif -%}
              </select><span aria-hidden="true">⌄</span></div></div>
              <div class="cw-studio__field"><label for="cw-placement-{{ section.id }}">Druckposition</label><div class="cw-studio__select-wrap"><select id="cw-placement-{{ section.id }}" name="properties[Druckposition]" data-cw-placement><option value="front">Vorderseite</option><option value="back">Rückseite (nur wenn unterstützt)</option></select><span aria-hidden="true">⌄</span></div></div>
            </div>
            <input type="hidden" name="quantity" value="1">
            <input type="hidden" name="properties[Namen]" value="" data-cw-names-property>
            <input type="hidden" name="properties[Personalisierung]" value="" data-cw-summary>
            <input type="hidden" name="properties[Designstil]" value="Minimal Line Art" data-cw-style-property>
            <input type="hidden" name="properties[_CW Design-ID]" value="" data-cw-design-id>
            <input type="hidden" name="properties[_CW Produktionsstatus]" value="Manuelle Druckfreigabe erforderlich" data-cw-production-status>
            <input type="hidden" name="return_to" value="{{ routes.cart_url }}">
            <div class="cw-studio__order-summary"><div><span data-cw-product-title>{{ cw_product.title | escape }}</span><strong data-cw-price>{{ cw_variant.price | money }}</strong></div><p><span aria-hidden="true">✓</span> Jede Druckdatei wird vor der Übergabe an Printful geprüft.</p></div>
            <button class="cw-studio__submit" type="submit" name="add" data-cw-submit data-add-text="Personalisiert in den Warenkorb" data-soldout-text="Diese Variante ist ausverkauft" {% unless cw_variant.available %}disabled{% endunless %}><span data-cw-submit-label>{% if cw_variant.available %}Personalisiert in den Warenkorb{% else %}Diese Variante ist ausverkauft{% endif %}</span><span aria-hidden="true">→</span></button>
            <p class="cw-studio__legal">Mit dem Hinzufügen bestätigst du Schreibweise und Vorschau. Die Produktion startet erst nach technischer Prüfung und ausdrücklicher Freigabe.</p>
            <p class="cw-studio__status" data-cw-status aria-live="polite"></p>
          </section>
        {%- endform -%}
      {%- else -%}
        <div class="cw-studio__setup" role="status"><span aria-hidden="true">!</span><div><strong>Printful-Produkt auswählen</strong><p>Öffne den Theme-Editor und wähle in diesem Abschnitt mindestens ein veröffentlichtes, mit Printful synchronisiertes Produkt aus.</p></div></div>
      {%- endif -%}
    </div>
  </div>
</section>
