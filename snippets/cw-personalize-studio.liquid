{%- liquid
  assign cw_product = section.settings.product
  if cw_product == blank
    assign cw_product = collections.all.products.first
  endif

  assign cw_variant = cw_product.selected_or_first_available_variant
  assign cw_product_image = cw_variant.featured_image | default: cw_product.featured_image
  assign cw_form_id = 'CW-Personalize-' | append: section.id

  if section.settings.artwork != blank
    assign cw_artwork_url = section.settings.artwork | image_url: width: 1000
  else
    assign cw_artwork_url = 'cw-hands-heart.svg' | asset_url
  endif
-%}

<section
  class="cw-studio"
  data-cw-studio
  data-example-names="{{ section.settings.example_names | escape }}"
  data-example-date="{{ section.settings.example_date | escape }}"
  style="--cw-preview-x:{{ section.settings.preview_x }}%;--cw-preview-y:{{ section.settings.preview_y }}%;--cw-preview-width:{{ section.settings.preview_width }}%;"
  aria-labelledby="cw-studio-title-{{ section.id }}"
>
  <div class="cw-studio__topbar">
    <a class="cw-studio__back" href="{{ routes.root_url }}"><span aria-hidden="true">←</span> Zurück zum Shop</a>
    <span class="cw-studio__top-note"><i aria-hidden="true"></i> Sicher personalisieren</span>
  </div>

  <div class="cw-studio__shell">
    <div class="cw-studio__visual" aria-label="Live-Vorschau des personalisierten Pullovers">
      <div class="cw-studio__visual-heading">
        <span><i aria-hidden="true"></i> LIVE-VORSCHAU</span>
        <span>PERSONAL EDITION</span>
      </div>

      <div class="cw-studio__mockup">
        {%- if cw_product_image != blank -%}
          <img
            class="cw-studio__product-image"
            src="{{ cw_product_image | image_url: width: 1400 }}"
            width="{{ cw_product_image.width }}"
            height="{{ cw_product_image.height }}"
            alt="{{ cw_product.title | escape }}"
            loading="eager"
            fetchpriority="high"
            data-cw-product-image
          >
        {%- else -%}
          <img class="cw-studio__product-image" src="{{ 'cw-campaign-hoodie.webp' | asset_url }}" width="1000" height="1600" alt="Hellblauer personalisierbarer Hoodie" data-cw-product-image>
        {%- endif -%}

        <div class="cw-studio__print" aria-hidden="true">
          <img src="{{ cw_artwork_url }}" width="700" height="390" alt="">
          <strong data-cw-names-preview>{{ section.settings.example_names | escape }}</strong>
          <span data-cw-date-preview>{{ section.settings.example_date | escape }}</span>
        </div>

        <span class="cw-studio__zoom-note"><span aria-hidden="true">✦</span> Vorschau aktualisiert sich live</span>
      </div>

      <div class="cw-studio__visual-footer">
        <span>EURE NAMEN. EUER DATUM.</span>
        <span aria-hidden="true">♡</span>
      </div>
    </div>

    <div class="cw-studio__content">
      <p class="cw-studio__eyebrow"><span aria-hidden="true">✦</span> COUPLE WEAR STUDIO</p>
      <h1 id="cw-studio-title-{{ section.id }}">{{ section.settings.title | escape }}</h1>
      <p class="cw-studio__lead">{{ section.settings.description | escape }}</p>

      {%- if cw_product != blank and cw_variant != blank -%}
        <div class="cw-studio__product-row">
          <div>
            <span>DEIN PRINTFUL-PRODUKT</span>
            <strong>{{ cw_product.title | escape }}</strong>
          </div>
          <span class="cw-studio__price" data-cw-price>{{ cw_variant.price | money }}</span>
        </div>

        {%- form 'product', cw_product, id: cw_form_id, class: 'cw-studio__form' -%}
          {%- if cw_product.variants.size > 1 -%}
            <div class="cw-studio__field">
              <label for="cw-variant-{{ section.id }}">Größe und Farbe</label>
              <div class="cw-studio__select-wrap">
                <select id="cw-variant-{{ section.id }}" name="id" data-cw-variant-select>
                  {%- for variant in cw_product.variants -%}
                    {%- assign cw_variant_image = variant.featured_image | default: cw_product.featured_image -%}
                    <option
                      value="{{ variant.id }}"
                      data-price="{{ variant.price | money | escape }}"
                      data-available="{{ variant.available }}"
                      {% if cw_variant_image != blank %}data-image="{{ cw_variant_image | image_url: width: 1400 }}"{% endif %}
                      {% if variant.id == cw_variant.id %}selected{% endif %}
                    >
                      {{ variant.title | escape }}{% unless variant.available %} – Ausverkauft{% endunless %}
                    </option>
                  {%- endfor -%}
                </select>
                <span aria-hidden="true">⌄</span>
              </div>
            </div>
          {%- else -%}
            <input type="hidden" name="id" value="{{ cw_variant.id }}">
          {%- endif -%}

          <div class="cw-studio__field">
            <label for="cw-names-{{ section.id }}">Eure Namen <em>*</em></label>
            <input
              id="cw-names-{{ section.id }}"
              name="properties[Namen]"
              type="text"
              maxlength="38"
              placeholder="z. B. David & Lena"
              autocomplete="off"
              required
              data-cw-names
              aria-describedby="cw-names-help-{{ section.id }}"
            >
            <div class="cw-studio__help" id="cw-names-help-{{ section.id }}">
              <span>Wird genau so für den Druck übernommen</span>
              <span data-cw-counter>0 / 38</span>
            </div>
          </div>

          <div class="cw-studio__field">
            <label for="cw-date-{{ section.id }}">Euer Datum <small>(optional)</small></label>
            <input
              id="cw-date-{{ section.id }}"
              name="properties[Datum]"
              type="text"
              maxlength="20"
              placeholder="z. B. 05.08.2022"
              autocomplete="off"
              data-cw-date
            >
          </div>

          <input type="hidden" name="quantity" value="1">
          <input type="hidden" name="properties[Personalisierung]" value="" data-cw-summary>
          <input type="hidden" name="properties[_CW Produktionsstatus]" value="Printful-Personalisierung erforderlich">
          <input type="hidden" name="return_to" value="{{ routes.cart_url }}">

          <div class="cw-studio__approval">
            <span aria-hidden="true">✓</span>
            <p><strong>Druckfreigabe mit Kontrolle</strong> Namen und Datum werden zusammen mit deiner Shopify-Bestellung an den Printful-Auftrag übergeben.</p>
          </div>

          <button
            class="cw-studio__submit"
            type="submit"
            name="add"
            data-cw-submit
            data-add-text="Personalisiert in den Warenkorb"
            data-soldout-text="Diese Variante ist ausverkauft"
            {% unless cw_variant.available %}disabled{% endunless %}
          >
            <span data-cw-submit-label>{% if cw_variant.available %}Personalisiert in den Warenkorb{% else %}Diese Variante ist ausverkauft{% endif %}</span>
            <span aria-hidden="true">→</span>
          </button>

          <p class="cw-studio__legal">Mit dem Hinzufügen bestätigst du die Schreibweise. Die Vorschau dient zur Orientierung; Druckposition und Größe können leicht abweichen.</p>
          <p class="cw-studio__status" data-cw-status aria-live="polite"></p>
        {%- endform -%}
      {%- else -%}
        <div class="cw-studio__setup" role="status">
          <span aria-hidden="true">!</span>
          <div>
            <strong>Printful-Produkt auswählen</strong>
            <p>Öffne den Theme-Editor und wähle in diesem Abschnitt deinen veröffentlichten, mit Printful synchronisierten Pullover aus.</p>
          </div>
        </div>
      {%- endif -%}

      <div class="cw-studio__trust" aria-label="Vorteile">
        <span>♡ Persönlich gefertigt</span>
        <span>♲ Bewusst produziert</span>
        <span>⌁ Sicher bezahlt</span>
      </div>
    </div>
  </div>
</section>
